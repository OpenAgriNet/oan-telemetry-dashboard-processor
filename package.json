{
  "name": "telemetry-log-processor",
  "version": "1.0.0",
  "description": "NodeJS microservice to process telemetry logs from PostgreSQL database",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ingest": "node ingest_csv.js --file",
    "backfill:pii": "node scripts/backfill-pii-masking.js",
    "backfill:pii:dry-run": "node scripts/backfill-pii-masking.js --dry-run",
    "backfill:pii:job": "node scripts/backfill-pii-masking-job.js",
    "backfill:pii:job:dry-run": "node scripts/backfill-pii-masking-job.js --dry-run",
    "backfill:pii:sql": "node scripts/backfill-pii-sql-column.js",
    "backfill:pii:sql:dry-run": "node scripts/backfill-pii-sql-column.js --dry-run",
    "backfill:prod:qid-pii": "sh scripts/prod-qid-pii-backfill.sh"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "lodash": "^4.17.21",
    "node-cron": "^3.0.2",
    "pg": "^8.11.3",
    "stream-json": "^1.9.1",
    "winston": "^3.10.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "^8.45.0",
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "telemetry",
    "logs",
    "processor",
    "microservice",
    "postgresql"
  ],
  "author": "",
  "license": "MIT"
}
